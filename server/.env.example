# Server Configuration
PORT=5000

# ------------------------------------------------------------------------------
# OPTION 1: MongoDB Atlas (Cloud - Recommended Permanent Solution)
# ------------------------------------------------------------------------------
# 1. Create a free cluster at https://www.mongodb.com/cloud/atlas
# 2. In "Database Access", create a user and password (e.g., admin / YourPassword123)
# 3. In "Network Access", add IP Access List: 0.0.0.0/0 (Allow access from anywhere)
# 4. Click "Connect" -> "Drivers" -> Copy connection string and paste below:
#
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/train-control?retryWrites=true&w=majority&appName=Cluster0

# ------------------------------------------------------------------------------
# OPTION 2: Local MongoDB (Default)
# ------------------------------------------------------------------------------
# For Windows local service (mongod):
MONGODB_URI=mongodb://127.0.0.1:27017/train-control
